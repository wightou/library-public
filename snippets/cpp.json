  "AtCoderのテンプレート（通常用）": {
    "prefix": "tmac",
    "body": [
      "#include <bits/stdc++.h>",
      "#include <atcoder/all>",
      "using namespace std;",
      "using namespace atcoder;",
      "",
      "// ライブラリ https://github.com/wightou/library-public",
      "",
      "/////////////////// メイン ///////////////////",
      "",
      "int main () {",
      "",
      "  ios::sync_with_stdio(false);",
      "  cin.tie(nullptr);",
      "  ",
      "  //////////////////// 入力 ////////////////////",
      "",
      "  int n;",
      "  cin >> n;",
      "",
      "  vector<int> a(n);",
      "  for (int i=0; i<n; i++) {",
      "    cin >> a.at(i);",
      "  }",
      "",
      "  //////////////// 出力変数定義 ////////////////",
      "",
      "  int result = 0;",
      "",
      "  //////////////////// 処理 ////////////////////",
      "",
      "  ",
      "",
      "  //////////////////// 出力 ////////////////////",
      "",
      "  cout << result << '\\n';",
      "",
      "  //////////////////// 終了 ////////////////////",
      "",
      "  return 0;",
      "",
      "}"
    ],
    "description": "AtCoderのテンプレート（通常用）"
  },
  "AtCoderのテンプレート（多種クエリ用）": {
    "prefix": "tmacq",
    "body": [
      "#include <bits/stdc++.h>",
      "#include <atcoder/all>",
      "using namespace std;",
      "using namespace atcoder;",
      "",
      "// ライブラリ https://github.com/wightou/library-public",
      "",
      "/////////////////// メイン ///////////////////",
      "",
      "int main () {",
      "",
      "  ios::sync_with_stdio(false);",
      "  cin.tie(nullptr);",
      "  ",
      "  /////////////////// 前入力 ///////////////////",
      "  ",
      "  int q;",
      "  cin >> q;",
      "",
      "  /////////////////// 前処理 ///////////////////",
      "",
      "  ",
      "",
      "  /////////////////// ループ ///////////////////",
      "",
      "  for (int loop=0; loop<q; loop++) {",
      "    ",
      "    int type;",
      "    cin >> type;",
      "    ",
      "    if (type==1) {",
      "",
      "      int x;",
      "      cin >> x;",
      "      ",
      "    } else if (type==2) {",
      "",
      "      int x;",
      "      cin >> x;",
      "",
      "    }",
      "",
      "  }",
      "",
      "  /////////////////// 後処理 ///////////////////",
      "",
      "",
      "",
      "  //////////////////// 終了 ////////////////////",
      "",
      "  return 0;",
      "",
      "}"
    ],
    "description": "AtCoderのテンプレート（多種クエリ用）"
  },
